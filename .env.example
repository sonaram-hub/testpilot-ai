# AI configuration is server-side only. OpenAI-compatible chat completions API.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Set a long random value for a shared deployment. For localhost, the app
# creates and persists a random token in .execution-token on first run.
EXECUTION_TOKEN=
PORT=8765
HOST=127.0.0.1
DATA_DIR=.

# Required when DEPLOYMENT_MODE=production. Choose a long, unique password.
APP_PASSWORD=

# Docker/cloud hosts set these values; leave blank for local use.
DEPLOYMENT_MODE=local
